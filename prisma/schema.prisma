generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(1000)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events      WorkEvent[]
  workCards   WorkCard[]

  @@index([workspaceId, updatedAt])
}

enum EventSource {
  github
  jira
  google_calendar
  manual
}

enum EventAction {
  commit_pushed
  pr_opened
  pr_merged
  pr_reviewed
  issue_opened
  issue_updated
  issue_closed
  task_updated
  note_added
}

model WorkEvent {
  id         String      @id @default(uuid()) @db.Uuid
  projectId  String      @db.Uuid
  source     EventSource
  // Stable source-side ID used for deduplication. Postgres treats NULLs as
  // distinct, so events without an externalId are never deduplicated.
  externalId String?
  timestamp  DateTime
  actor      String
  action     EventAction
  summary    String
  sourceUrl  String?
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now())
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, externalId])
  @@index([projectId, timestamp])
}

// ---------- Daily Intake ----------

enum Actor {
  user
  hermes
  github
  system
}

enum SprintStatus {
  planned
  active
  closed
}

enum CardStatus {
  active
  paused
  done
  archived
}

enum CalendarEventKind {
  calendar // anything that came from Google Calendar
  work_block // a block created by Hermes for a checklist item or alert
}

enum CalendarEventStatus {
  confirmed
  tentative
  cancelled
}

enum ScheduleStatus {
  checking // request sent, waiting for the conflict check / Hermes
  conflict // overlaps something; suggestion may be set
  booked // calendar event created and cached
  failed // Hermes or Google error
  cancelled // user closed it before it finished
}

enum BannerKind {
  gmail
  orphans
  scan
  stocks
}

enum AlertSeverity {
  warning
  critical
}

/// A time-boxed group of Working-on cards.
model Sprint {
  id          String       @id @default(uuid()) @db.Uuid
  /// Stable key for idempotent upserts by Hermes or GitHub sync, e.g. "hermes:sprint:2026-10-12".
  externalKey String?      @unique @db.VarChar(200)
  name        String       @db.VarChar(120)
  goal        String?      @db.VarChar(500)
  startsOn    DateTime     @db.Date
  endsOn      DateTime     @db.Date
  status      SprintStatus @default(planned)
  createdBy   Actor        @default(user)
  /// Optimistic concurrency, same rule as WorkCard.version (D15).
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cards       WorkCard[]

  @@index([status, startsOn])
}

/// One card in the "Working on" column. Fully data-driven: created/updated by the user, GitHub sync or Hermes.
model WorkCard {
  id               String          @id @default(uuid()) @db.Uuid
  externalKey      String?         @unique @db.VarChar(200)
  title            String          @db.VarChar(160)
  /// "owner/repo" when the card mirrors a GitHub repository.
  repoFullName     String?         @db.VarChar(200)
  milestoneTitle   String?         @db.VarChar(160)
  /// Deadline (a local date; overdue once that day is over). Items without their own fall under this.
  dueOn            DateTime?       @db.Date
  sprintId         String?         @db.Uuid
  /// Optional link to the existing Project so WorkEvents can feed the card's meta line.
  projectId        String?         @db.Uuid
  status           CardStatus      @default(active)
  /// Sort order inside the column (gaps allowed; reorder by rewriting positions).
  position         Int             @default(0)
  createdBy        Actor           @default(user)
  /// One-line Hermes prompt on the collapsed card, e.g. "Block 90 min tonight for #12?". Null hides the row.
  hermesSuggestion String?         @db.VarChar(300)
  lastActivityAt   DateTime?
  /// Free-form extras (e.g. weekly commit count) shown in the meta line.
  meta             Json            @default("{}")
  /// Optimistic concurrency: clients send the version they edited; mismatches return 409.
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sprint           Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items            ChecklistItem[]

  @@index([status, position])
  @@index([sprintId])
}

/// A checklist row inside a card (usually a GitHub issue).
model ChecklistItem {
  id               String            @id @default(uuid()) @db.Uuid
  cardId           String            @db.Uuid
  externalKey      String?           @unique @db.VarChar(200)
  title            String            @db.VarChar(200)
  issueNumber      Int?
  sourceUrl        String?
  /// Deadline (a local date). Null = the card's dueOn applies.
  dueOn            DateTime?         @db.Date
  done             Boolean           @default(false)
  doneAt           DateTime?
  /// Who checked it: user (on the page) or hermes (its API, with force). Null while open, and on
  /// items checked before this was recorded.
  doneBy           Actor?
  /// The push update Gerardo confirmed to check it ("looks done from push X"); the page links that push.
  doneProgressId   String?           @unique @db.Uuid
  doneProgress     ItemProgress?     @relation("DoneByPush", fields: [doneProgressId], references: [id], onDelete: SetNull)
  /// The "now"/"next" item shown on the collapsed card. At most one per card (enforce in code).
  isCurrent        Boolean           @default(false)
  position         Int               @default(0)
  createdBy        Actor             @default(user)
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  card             WorkCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  calendarEvents   CalendarEvent[]
  scheduleRequests ScheduleRequest[]
  progress         ItemProgress[]    @relation("ItemProgress")
  checkinItems     CheckinItem[]

  @@index([cardId, position])
}

/// Cache of Google Calendar events used to build the daily timeline.
/// Unlike WorkEvent, rows are updated and cancelled when the calendar changes.
model CalendarEvent {
  id              String              @id @default(uuid()) @db.Uuid
  calendarId      String              @db.VarChar(200)
  externalId      String              @db.VarChar(1024)
  title           String              @db.VarChar(300)
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean             @default(false)
  kind            CalendarEventKind   @default(calendar)
  status          CalendarEventStatus @default(confirmed)
  checklistItemId String?             @db.Uuid
  alertId         String?             @db.Uuid
  etag            String?             @db.VarChar(200)
  htmlLink        String?
  syncedAt        DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  checklistItem   ChecklistItem?      @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  alert           Alert?              @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@unique([calendarId, externalId])
  @@index([startsAt])
  @@index([endsAt])
}

/// Stores the incremental sync token per calendar so syncs only fetch changes.
model CalendarSyncState {
  calendarId String    @id @db.VarChar(200)
  syncToken  String?
  lastSyncAt DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt
}

/// One "Schedule with Hermes" conversation for a checklist item or alert.
model ScheduleRequest {
  id              String         @id @default(uuid()) @db.Uuid
  checklistItemId String?        @db.Uuid
  alertId         String?        @db.Uuid
  requestedStart  DateTime
  durationMin     Int
  status          ScheduleStatus @default(checking)
  /// Conflicting event when status = conflict.
  conflictEventId String?        @db.Uuid
  suggestedStart  DateTime?
  calendarEventId String?        @db.Uuid
  hermesRunId     String?        @db.VarChar(200)
  /// [{ who: "hermes" | "me", text, at }]
  transcript      Json           @default("[]")
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  alert           Alert?         @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([checklistItemId, createdAt])
}

/// The banner's first slide. One row per local date.
model DailyMessage {
  date      DateTime @id @db.Date
  text      String   @db.VarChar(500)
  author    Actor    @default(user)
  updatedAt DateTime @updatedAt
}

/// Latest data for a banner slide, pushed by Hermes or n8n. History is kept; the page reads the newest per kind.
model BannerSnapshot {
  id         String     @id @default(uuid()) @db.Uuid
  kind       BannerKind
  /// Shape depends on kind; validated against the schemas in src/types/dashboard-contracts.ts.
  payload    Json
  capturedAt DateTime
  pushedBy   Actor      @default(hermes)
  createdAt  DateTime   @default(now())

  /// One row per capture, so a retried PUT /api/hermes/banner/:kind can never duplicate it.
  @@unique([kind, capturedAt])
  @@index([kind, capturedAt])
}

/// Entries for the "Important" panel: things Hermes found that need Gerardo (a failed backup, a
/// Seerr request waiting for days, a mail left unanswered, a big stock swing).
model Alert {
  id               String            @id @default(uuid()) @db.Uuid
  /// Stable key so repeated pushes update the same alert, e.g. "proxmox:vzdump:vm100".
  dedupeKey        String            @unique @db.VarChar(200)
  /// Important groups its entries by source.
  source           String            @db.VarChar(100)
  title            String            @db.VarChar(200)
  detail           String?           @db.VarChar(500)
  /// Where Gerardo acts on it (the Seerr request, the mail thread, the Jira issue); http(s) only.
  url              String?           @db.VarChar(2048)
  severity         AlertSeverity     @default(warning)
  openedAt         DateTime          @default(now())
  resolvedAt       DateTime?
  /// Gerardo hid it on the page. It stays hidden while the problem lasts and shows again when Hermes
  /// reopens it after a resolve, or raises it from warning to critical.
  dismissedAt      DateTime?
  meta             Json              @default("{}")
  updatedAt        DateTime          @updatedAt
  calendarEvents   CalendarEvent[]
  scheduleRequests ScheduleRequest[]

  @@index([resolvedAt, openedAt])
}

enum ProgressKind {
  looks_done // Hermes thinks a push finished the item; waits for the user to confirm
  partial // a push moved the item forward but did not finish it
}

enum ProgressStatus {
  pending // looks_done waiting for the user; partial notes stay pending until dismissed
  confirmed // user accepted a looks_done suggestion (the item is checked)
  dismissed // user rejected or hid it
}

/// What one push did to one checklist item, as judged by Hermes. Only repos that have a WorkCard are matched.
model ItemProgress {
  id              String         @id @default(uuid()) @db.Uuid
  checklistItemId String         @db.Uuid
  repoFullName    String         @db.VarChar(200)
  commitSha       String         @db.VarChar(64)
  kind            ProgressKind
  /// Hermes's one-line explanation, e.g. "added the streak model; UI still missing".
  note            String         @db.VarChar(500)
  status          ProgressStatus @default(pending)
  pushedAt        DateTime
  createdBy       Actor          @default(hermes)
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  checklistItem   ChecklistItem  @relation("ItemProgress", fields: [checklistItemId], references: [id], onDelete: Cascade)
  /// The item this update checked, once Gerardo confirmed it.
  checkedItem     ChecklistItem? @relation("DoneByPush")

  /// The same push is never recorded twice for the same item (idempotent Hermes writes).
  @@unique([checklistItemId, commitSha])
  @@index([checklistItemId, createdAt])
  @@index([status])
}

/// A branch the push review watches: a card repo's default branch, or one of its open pull requests.
/// The GitHub sync keeps headSha current; the push-review job sends Hermes the commits after
/// reviewedSha and turns its answer into push updates (ItemProgress).
model PushWatch {
  id             String    @id @default(uuid()) @db.Uuid
  /// "owner/repo", lowercased (GitHub names are case-insensitive).
  repo           String    @db.VarChar(200)
  /// "branch:<name>" for the default branch, "pr:<number>" for a pull request.
  ref            String    @db.VarChar(300)
  branch         String    @db.VarChar(255)
  prNumber       Int?
  prTitle        String?   @db.VarChar(300)
  /// The branch a pull request merges into.
  baseBranch     String?   @db.VarChar(255)
  /// Newest commit the sync saw.
  headSha        String    @db.VarChar(64)
  /// Last commit reviewed (or skipped). Null: a pull request with none of its commits reviewed yet.
  reviewedSha    String?   @db.VarChar(64)
  /// The Hermes run reviewing up to runToSha; null when no review is running.
  hermesRunId    String?   @db.VarChar(200)
  runStartedAt   DateTime?
  runToSha       String?   @db.VarChar(64)
  /// The newest reviewed commit: this run's push updates point at it.
  runCommitSha   String?   @db.VarChar(64)
  runCommittedAt DateTime?
  /// Failed tries for the current commits; the third moves on and raises an Important alert.
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastError      String?   @db.VarChar(500)
  /// The pull request was merged. Kept a week so the default branch skips the commits it brought in.
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([repo, ref])
}

/// A line in the Notes panel: small things to remember. Gerardo writes his on the page; Hermes
/// upserts its own by key (e.g. "PRs to review · 3"). Deleting one is for good.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  /// Hermes notes only: "<source>:<thing>", same format as Alert.dedupeKey, e.g. github:prs-to-review.
  key       String?  @unique @db.VarChar(200)
  author    Actor
  text      String   @db.VarChar(200)
  detail    String?  @db.VarChar(200)
  url       String?  @db.VarChar(2048)
  /// Shown on the right, e.g. 3 PRs to review. A note with count 0 is hidden; null shows no count.
  count     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// The weekly check-in Hermes writes mid-week and updates before the weekend. It is the first banner
/// slide from when it is written until the week ends (Sunday night, local).
model WeeklyCheckin {
  id        String        @id @default(uuid()) @db.Uuid
  /// Monday of the local week it belongs to.
  weekOf    DateTime      @unique @db.Date
  summary   String        @db.VarChar(1000)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     CheckinItem[]
}

/// One line of a check-in's focus list. Linked to a checklist item, it shares that item's done state
/// (checking either one checks both); otherwise it keeps its own.
model CheckinItem {
  id              String         @id @default(uuid()) @db.Uuid
  checkinId       String         @db.Uuid
  /// Hermes's name for the line within the week, e.g. "streak-tracking"; kept across updates.
  key             String         @db.VarChar(100)
  text            String         @db.VarChar(200)
  position        Int            @default(0)
  checklistItemId String?        @db.Uuid
  /// Only used when the line is not linked to a checklist item.
  done            Boolean        @default(false)
  doneAt          DateTime?
  checkin         WeeklyCheckin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@unique([checkinId, key])
}

/// Symbols shown on the stocks banner slide. Hermes or the user can replace the list at any time.
model WatchlistSymbol {
  symbol            String    @id @db.VarChar(16)
  position          Int
  addedBy           Actor     @default(user)
  /// Cached 6-month change in percent, refreshed daily from Tiingo; the quote sync reads it.
  sixMonthChangePct Float?
  sixMonthAsOf      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([position])
}

/// One top-level file or folder in orphaned_data, as seen by the weekly orphans check. Deleted when it
/// is gone from the folder.
model OrphanEntry {
  id          String   @id @default(uuid()) @db.Uuid
  /// Raw file/folder name as listed, e.g. "Movie.2024.1080p.BluRay".
  name        String   @unique @db.VarChar(255)
  /// Number of checks that listed it (1 on the first).
  seenCount   Int      @default(1)
  firstSeenAt DateTime
  lastSeenAt  DateTime
  updatedAt   DateTime @updatedAt
}

/// The page's look, the same on every device: one row (id 1). Values are ids from
/// src/lib/appearance/themes.ts; an unknown value reads as the default.
model Appearance {
  id         Int      @id @default(1)
  theme      String   @db.VarChar(40)
  background String   @db.VarChar(40)
  updatedBy  Actor    @default(user)
  updatedAt  DateTime @updatedAt
}
